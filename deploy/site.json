{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "What one environment of the fleet health dashboard is made of: one storage account that serves the site's files as a static website. No key opens it: shared keys are off, and the release writes the files as the tier's deploy identity (Storage Blob Data Contributor on the resource group, platform/azure.bicep). The website itself is switched on by the release (deploy/deploy.ps1): Azure Resource Manager has no property for it."
  },
  "parameters": {
    "environmentName": { "type": "string" },
    "location": { "type": "string", "defaultValue": "[resourceGroup().location]" }
  },
  "variables": {
    "accountName": "[format('stcmfleet{0}{1}', parameters('environmentName'), take(uniqueString(resourceGroup().id), 6))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('accountName')]",
      "location": "[parameters('location')]",
      "tags": {
        "system": "cmfleet",
        "environment": "[parameters('environmentName')]",
        "deployable": "dashboard"
      },
      "sku": { "name": "Standard_LRS" },
      "kind": "StorageV2",
      "properties": {
        "accessTier": "Hot",
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": false,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true
      }
    }
  ],
  "outputs": {
    "accountName": { "type": "string", "value": "[variables('accountName')]" },
    "url": { "type": "string", "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', variables('accountName')), '2023-05-01').primaryEndpoints.web]" }
  }
}
