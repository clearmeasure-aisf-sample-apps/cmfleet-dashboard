      "variances": [
        {
          "variance": "Not built with the kit: its own environment repository, no system.json, apps that declare themselves in apps/<app>.yaml",
          "reason": "A delivery platform designed on its own (\"the platform is app-neutral and the apps are platform-neutral\"), earlier than the kit and kept as it is",
          "rule": ""
        },
        {
          "variance": "Builds run in Codefresh, not in GitHub Actions",
          "reason": "One verb per tool: Codefresh builds, Octopus releases, Argo CD applies (README of its environment repository). The fleet reads its builds as commit statuses",
          "rule": ""
        },
        {
          "variance": "Promotion to uat and prod is automatic, with no sign-off",
          "reason": "Its lifecycle platform-continuous promotes tdd, uat and prod automatically; no approvals by design (apps/workorders.yaml)",
          "rule": "policy/sign-off"
        },
        {
          "variance": "Follows none of the kit's templates",
          "reason": "What it is made of is its own (principle 007): its own clusters, Argo CD, SQL Server Express per app",
          "rule": "templates"
        },
        {
          "variance": "Sleeps by default: the clusters of tdd, uat and prod are stopped outside 07:00 to 19:00 Central on weekdays and after 120 idle minutes; only an Octopus or Codefresh job wakes them",
          "reason": "Cost: an unreachable node is normal most of the time (docs/runbooks/sleep-and-wake.md of its environment repository; stated by its owner session, 2026-10-07)",
          "rule": ""
        },
        {
          "variance": "Three clusters: nonprod (tdd and uat), prod, and a build cluster for Codefresh that never stops",
          "reason": "Its own design: builds are separated from where apps run (stated by its owner session, 2026-10-07)",
          "rule": ""
        },
        {
          "variance": "The database is SQL Server 2022 Express in the cluster, one per environment, not a managed database",
          "reason": "Its own application architecture (principle 007; stated by its owner session, 2026-10-07)",
          "rule": ""
        },
        {
          "variance": "The deployed version is pinned as image tags in gitops/apps/<app>/envs/<env>/app/kustomization.yaml, committed by Octopus and applied by Argo CD; there is no versions.json",
          "reason": "Argo CD applies what Git says; the pin commit is the record (stated by its owner session, 2026-10-07)",
          "rule": ""
        },
        {
          "variance": "Production is frozen every weekend, Saturday 00:00 to Monday 00:00 UTC; promotion is otherwise automatic",
          "reason": "A standing deployment freeze. The fleet allows its environments 72 hours behind the first one instead of 24 (fleet.promotionLagHours), so a weekend is not a finding (stated by its owner session, 2026-10-07)",
          "rule": ""
        },
        {
          "variance": "Its dashboard is served by GitHub Pages from its own repository, with a committed topology; it is not released through Octopus",
          "reason": "Its own design (stated by its owner session, 2026-10-07)",
          "rule": ""
        },
        {
          "variance": "GitHub Actions workflows are not its gates: codefresh/ci, codefresh/release and codefresh/env-checks are. The app repository still has a legacy Actions build whose job Publish Release Candidate fails on every run",
          "reason": "One verb per tool: Codefresh builds. The fleet reads its commit statuses and raises no finding for its Actions workflows (stated by its owner session, 2026-10-07)",
          "rule": "workflow"
        }
